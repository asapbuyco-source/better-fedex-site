# Firebase configuration (tracking only)
# 1. Copy this file to .env  (cp .env.example .env)
# 2. Firebase Console -> Project Settings -> Your apps -> Web app -> Config
# 3. Firebase Console -> Firestore Database -> Create database (production or test mode)
# 4. (Recommended) Firestore Rules for this demo:
#      rules_version = '2';
#      service cloud.firestore {
#        match /databases/{database}/documents {
#          match /shipments/{id} {
#            allow read: if true;
#            allow write: if true;   // tighten for production
#          }
#          match /activity/{id} {
#            allow read, write: if true;
#          }
#        }
#      }
# 5. Netlify: Site settings -> Environment variables -> add each VITE_* value, then redeploy

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
